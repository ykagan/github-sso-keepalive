{
  "manifest_version": 3,
  "name": "GitHub SSO Keepalive",
  "version": "1.0.0",
  "description": "Keeps GitHub org/enterprise SAML SSO sessions alive by pressing the SSO \"Continue\" button automatically.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GitHub SSO Keepalive"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
